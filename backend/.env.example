# For local (non-Docker) development. Copy to backend/.env and adjust as needed.
PORT=4000
APP_ENV=development
# Run `docker compose up -d postgres` from the repo root, or point this at any local Postgres.
DATABASE_URL=postgres://familycalendar:familycalendar@localhost:5432/familycalendar?sslmode=disable

APP_PASSWORD=change-me
SESSION_SECRET=dev-secret-change-me

PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Optional — leave blank to run without Google Calendar sync locally.
# Redirect URI to authorize in Google Cloud Console: http://localhost:4000/api/accounts/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# When unset: defaults to "true" outside APP_ENV=production as long as the Google
# credentials above are blank, so the app is browsable with generated fake events
# out of the box. Set explicitly to "true"/"false" to override that default.
# MOCK_EVENTS=

PARTNER_A_NAME=Partner A
PARTNER_B_NAME=Partner B
