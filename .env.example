# ---- Domain & networking ----
# The domain this app will be served from (DNS A/AAAA record must point at this host).
DOMAIN=calendar.example.com
# Email used by Caddy for Let's Encrypt certificate notifications.
ACME_EMAIL=you@example.com

# ---- App access ----
# Shared password gate protecting the whole app (it's on the public internet).
APP_PASSWORD=change-me
# Random long string used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-too

# ---- Database ----
# Password for the Postgres container (data lives in the postgres_data Docker volume).
POSTGRES_PASSWORD=change-me-postgres

# ---- Google OAuth ----
# From Google Cloud Console > APIs & Services > Credentials (OAuth Client ID, type "Web application").
# Authorized redirect URI must be: https://${DOMAIN}/api/accounts/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Display names for the two calendar slots ----
PARTNER_A_NAME=Partner A
PARTNER_B_NAME=Partner B
